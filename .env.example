# Uniquement portainer-ghcr.yml : image versionnée ou digest GHCR publié.
# ANIPIC_IMAGE=ghcr.io/gaerisson/anipic:3.10.2
# Montage du NAS réalisé sur l'hôte Debian, avant de démarrer le conteneur.
ANIPIC_MEDIA_PATH=/mnt/nas/anipic/photos
ANIPIC_BACKUP_PATH=/mnt/nas/anipic/backups
ANIPIC_UID=1000
ANIPIC_GID=1000
ANIPIC_BIND_IP=127.0.0.1
ANIPIC_PORT=8088
APP_ORIGIN=http://localhost:8088
COOKIE_SECURE=false
TRUST_PROXY=false
PROXY_TRUSTED_IPS=127.0.0.1,::1
MAX_UPLOAD_MB=25
# Limite par fichier vidéo/audio (1 à 4096 Mo). Adapter aussi le reverse proxy.
MAX_MEDIA_MB=512
CACHE_MB=512
ANIPIC_MEMORY_LIMIT=2g
VIDEO_RENDER_ENABLED=true
# IA optionnelle. Les clés sont uniquement utilisées par le serveur.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TOKENHARBOR_API_KEY=
TOKENHARBOR_MODEL=
# Canva Connect : application Outside Canva, secrets uniquement côté serveur.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Générer une fois : node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CANVA_TOKEN_KEY=
# Exactement APP_ORIGIN + /api/canva/callback ; HTTPS en production.
CANVA_REDIRECT_URI=
# Voix off Mistral, clé serveur ; aucune génération automatique.
MISTRAL_API_KEY=
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
MISTRAL_STT_MODEL=voxtral-mini-latest
# Facultatif : chemin du binaire FFmpeg, sinon celui de Remotion est utilisé.
FFMPEG_PATH=
MISTRAL_TTS_VOICE_ID=
# Facultatif : activer compose.c8.yml après avoir renseigné ce chemin.
ANIPIC_C8_PATH=
# Sans Docker : chemin absolu du dossier des émissions, sinon laisser vide.
BROADCAST_DIR=
# Dépôt facultatif des exports Lightroom/Photoshop ; activer compose.import.yml.
ANIPIC_IMPORT_PATH=
# Sans Docker : chemin absolu du dossier de dépôt, lecture manuelle ou planifiée depuis API & connexions.
IMPORT_DIR=
# Pour un flux JSON sur votre propre domaine, ajouter ce domaine ici.
SOURCE_ALLOWED_HOSTS=www.la-spa.fr,la-spa.fr,api-spa.gaerisson-softs.fr,srv.gaerisson-softs.fr

# Pays des visiteurs : en-tête ajouté et remplacé par votre proxy de confiance.
# Exemple Cloudflare : cf-ipcountry. Laisser vide sans géolocalisation côté proxy.
VISITOR_COUNTRY_HEADER=

# Facultatif : MMDB locale personnalisée. Sinon la base DB-IP Lite fournie est utilisée.
GEOIP_DB_PATH=

# Optional Google login; enable and approve volunteers in Team & access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
